{
    "name": "delboy1978uk/bone-i18n",
    "description": "I18n package for Bone Framework",
    "license": "MIT",
    "authors": [
        {
            "name": "Derek Stephen McLean",
            "email": "delboy1978uk@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-intl": "*",
        "boneframework/contracts": "^1.8",
        "delboy1978uk/barnacle": "^2.3",
        "delboy1978uk/bone-http": "^2.3",
        "delboy1978uk/bone-view": "^v1.7",
        "delboy1978uk/form": "^2.7",
        "psr/http-message": "^2.0",
        "psr/http-server-middleware": "^1.0",
        "symfony/translation": "^7.0"
    },
    "require-dev": {
        "roave/security-advisories": "dev-latest",
        "delboy1978uk/dev-tools": "^1.1",
        "delboy1978uk/bone-router": "^1.4",
        "laminas/laminas-diactoros": "^3.3"
    },
    "autoload": {
        "psr-4": {
            "Bone\\I18n\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BoneTest\\": "tests/unit/"
        }
    },
    "config": {
        "allow-plugins": {
            "phpro/grumphp": false
        }
    }
}
